<?xml version="1.0" encoding="utf-8"?>
<!--
  전경 — "쌓이는 반복, 그리고 지금".

  점 넷이 왼쪽 아래에서 오른쪽 위로 오르며 커지고 또렷해진다: 반복이
  쌓일수록 확신이 자라고, 마지막 하나가 제안이 된다. 이 앱이 하는 일
  그대로다. 처음엔 원 궤도로 그렸는데 로딩 스피너처럼 읽혀(실측 신고)
  균등한 원 배치를 버렸다.

  밝은 배경이라 발광 대신 **진한 코어 + 옅은 헤일로**로 마지막 점을
  세운다 — 밝은 바탕 위의 빛은 눈에 띄지 않고 번짐으로만 보인다.
  코어는 중앙 안전 영역 안이라 어떤 마스크에도 잘리지 않는다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 쌓이는 반복 — 갈수록 커지고 또렷해진다 -->
    <path
        android:pathData="M33,70 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0"
        android:fillColor="#0E7A58"
        android:fillAlpha="0.3" />
    <path
        android:pathData="M47,62 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
        android:fillColor="#0E7A58"
        android:fillAlpha="0.48" />
    <path
        android:pathData="M61,52 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0"
        android:fillColor="#0E7A58"
        android:fillAlpha="0.7" />

    <!-- 지금 이 순간 — 헤일로 두 겹과 진한 코어 -->
    <path
        android:pathData="M75,40 m-12.5,0 a12.5,12.5 0 1,0 25,0 a12.5,12.5 0 1,0 -25,0"
        android:fillColor="#12A074"
        android:fillAlpha="0.15" />
    <path
        android:pathData="M75,40 m-8.4,0 a8.4,8.4 0 1,0 16.8,0 a8.4,8.4 0 1,0 -16.8,0"
        android:fillColor="#12A074"
        android:fillAlpha="0.3" />
    <path
        android:pathData="M75,40 m-5.6,0 a5.6,5.6 0 1,0 11.2,0 a5.6,5.6 0 1,0 -11.2,0"
        android:fillColor="#0C7A57" />
</vector>
