<?xml version="1.0" encoding="utf-8"?>
<!--
  전경 — "반복의 궤도 위, 지금 이 순간".

  원은 매일 같은 자리로 돌아오는 리듬(루틴)이고, 궤도 위 흐린 점들은
  지나간 반복이다. 12시의 밝은 점 하나만 발광하는데, 그게 이 앱이 하는
  일이다: 반복을 발견해 **그 순간**에 말을 건다. 팝업의 가장자리 발광과
  같은 언어(teal #1D9E75)를 쓴다.

  시각 요소는 전부 중앙 안전 영역(66dp, 반지름 33) 안에 둔다 — 런처가
  원·사각·물방울 어떤 마스크로 잘라도 잘리지 않는다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 궤도 -->
    <path
        android:pathData="M54,32 A22,22 0 1,1 53.9,32"
        android:strokeColor="#1D9E75"
        android:strokeWidth="2.6"
        android:strokeAlpha="0.34"
        android:strokeLineCap="round" />

    <!-- 지나간 반복 — 궤도 위 흐린 점 둘 -->
    <path
        android:pathData="M73.05,65 m-2.7,0 a2.7,2.7 0 1,0 5.4,0 a2.7,2.7 0 1,0 -5.4,0"
        android:fillColor="#1D9E75"
        android:fillAlpha="0.5" />
    <path
        android:pathData="M34.95,65 m-2.7,0 a2.7,2.7 0 1,0 5.4,0 a2.7,2.7 0 1,0 -5.4,0"
        android:fillColor="#1D9E75"
        android:fillAlpha="0.32" />

    <!-- 지금 이 순간 — 발광 두 겹과 코어 -->
    <path
        android:pathData="M54,32 m-12.5,0 a12.5,12.5 0 1,0 25,0 a12.5,12.5 0 1,0 -25,0"
        android:fillColor="#1D9E75"
        android:fillAlpha="0.13" />
    <path
        android:pathData="M54,32 m-8.4,0 a8.4,8.4 0 1,0 16.8,0 a8.4,8.4 0 1,0 -16.8,0"
        android:fillColor="#2ED694"
        android:fillAlpha="0.26" />
    <path
        android:pathData="M54,32 m-5.4,0 a5.4,5.4 0 1,0 10.8,0 a5.4,5.4 0 1,0 -10.8,0"
        android:fillColor="#3BE6A2" />
</vector>
