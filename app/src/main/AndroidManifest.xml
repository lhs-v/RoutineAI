<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 사용 통계 접근. 설치만으로는 켜지지 않고 사용자가 설정에서 직접 허용해야 합니다. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 네트워크 사용량(앱별 Wi-Fi/모바일 구분)에 필요 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 현재 접속한 Wi-Fi 이름(SSID)을 읽으려면 위치 권한이 필요합니다.
         과거 SSID 이력은 시스템이 앱에 제공하지 않으므로, 설치 시점부터 앱이 직접 기록합니다. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 인터넷은 LLM 해석 기능을 켰을 때만 사용합니다. 끄면 완전히 오프라인으로 동작합니다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".RoutineApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoutineAI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 알림 통계용. 사용자가 '알림 접근'에서 직접 허용해야 동작합니다. -->
        <service
            android:name=".collect.NotifListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
