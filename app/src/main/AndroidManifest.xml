<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 사용 통계 접근. 설치만으로는 켜지지 않고 사용자가 설정에서 직접 허용해야 합니다. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 네트워크 사용량(앱별 Wi-Fi/모바일 구분)에 필요 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 현재 접속한 Wi-Fi 이름(SSID)을 읽으려면 위치 권한이 필요합니다.
         과거 SSID 이력은 시스템이 앱에 제공하지 않으므로, 설치 시점부터 앱이 직접 기록합니다. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 통신량의 uid 와 사용 이벤트의 패키지명을 앱 이름으로 되돌리는 데 필요합니다.
         Android 11+ 는 이 선언 없이 다른 앱을 조회하지 못해(패키지 가시성),
         설치돼 있는 앱도 "uid10340" 처럼 숫자로만 남습니다.
         개인용 사이드로드 기준의 선언이며, 스토어 배포 시에는 심사 대상입니다. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 실시간 제안 팝업. 다른 앱 위에 카드 하나를 띄우는 데 필요합니다. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 앱 맥락 모드(유튜브 중 자동 회전 등)가 시스템 설정을 바꾸는 데 필요합니다.
         앱이 꺼지면 원복합니다. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 방해금지 모드 켜고 끄기 (앱 맥락 모드용) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- 인터넷은 LLM 해석 기능을 켰을 때만 사용합니다. 끄면 완전히 오프라인으로 동작합니다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 블루투스 연결/해제 기록. 기기 이름을 읽으려면 런타임 허용이 필요합니다. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Health Connect 읽기. 운동·수면 세션은 행동의 상태 맥락이자
         화면 공백 기반 수면 추정을 교차 검증할 유일한 독립 소스입니다. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <application
        android:name=".RoutineApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoutineAI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- BT 연결/해제. ACL 브로드캐스트는 암시적 제한 예외라 매니페스트 리시버로 받는다. -->
        <receiver android:name=".collect.BtReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Health Connect 권한 사용 근거 화면 (권한 요청 시 시스템이 이 인텐트를 띄운다) -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- 앱 전환을 즉시 감지해 제안 트리거를 매칭한다. 화면 내용은 읽지 않는다
             (이벤트 종류를 windowStateChanged 로 제한, 콘텐츠 접근 플래그 없음). -->
        <service
            android:name=".watch.PatternAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- 알림 통계용. 사용자가 '알림 접근'에서 직접 허용해야 동작합니다. -->
        <service
            android:name=".collect.NotifListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
